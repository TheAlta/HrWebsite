# Copy to /srv/hrweb/<environment>/.env on the server (chmod 600). Never commit it.
# Keep comments on their own lines: deploy.sh and backup.sh read this file directly.

# --- which stack ---
# production 8001, staging 8002
WEB_PORT=8001
DATA_DIR=/srv/hrweb/production

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=arezoo-zahmatbaran.ir,localhost
CSRF_TRUSTED_ORIGINS=https://arezoo-zahmatbaran.ir
WAGTAILADMIN_BASE_URL=https://arezoo-zahmatbaran.ir
SITE_NAME=Arezoo
TRUST_X_FORWARDED_FOR=true
# false on staging
SEO_ALLOW_INDEXING=true
# Choose your own, not the default paths
WAGTAIL_ADMIN_PATH=panel/
DJANGO_ADMIN_PATH=django-admin/

# --- database ---
POSTGRES_DB=hrweb
POSTGRES_USER=hrweb
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
DATABASE_URL=postgres://hrweb:CHANGE_ME@db:5432/hrweb

# --- email ---
# smtp+tls://user:password@mail.example.ir:587
EMAIL_URL=
DEFAULT_FROM_EMAIL=noreply@arezoo-zahmatbaran.ir

# --- SMS ---
SMS_PROVIDER=apps.notifications.providers.kavenegar.KavenegarSMS
KAVENEGAR_API_KEY=
SMS_TPL_OTP=
SMS_TPL_LEAD_RECEIVED=
SMS_TPL_LEAD_ADMIN=
SMS_TPL_BOOKING_CONFIRMED=
SMS_TPL_BOOKING_REMINDER=
SMS_TPL_BOOKING_CANCELLED=
SMS_TPL_BOOKING_PROBLEM=
SMS_TPL_EVENT_REGISTERED=
SMS_TPL_EVENT_WAITLISTED=
SMS_TPL_EVENT_SEAT_OPEN=
SMS_TPL_EVENT_CANCELLED=
SMS_TPL_EVENT_REMINDER=
SMS_TPL_EVENT_RECORDING=
SMS_TPL_EVENT_PROBLEM=
SMS_TPL_ORDER_DIGITAL=
SMS_TPL_ORDER_SHIPPED=
SMS_TPL_ORDER_PROBLEM=
ALERT_EMAILS=

# --- payment ---
PAYMENT_GATEWAY_ORDER=zarinpal,zibal
ZARINPAL_MERCHANT_ID=
# true on staging
ZARINPAL_SANDBOX=false
ZIBAL_MERCHANT=

# --- error tracking (optional) ---
SENTRY_DSN=
