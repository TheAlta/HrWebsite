# HTTPS certificates are issued and renewed by Caddy automatically.
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	# Largest request body, uploads included: stops a huge upload filling the disk.
	# Paid course videos, if any, go to object storage directly (spec section 7)
	request_body {
		max_size 100MB
	}
	header {
		-Server
	}
	# Uploaded images and documents: served directly, never executed
	handle_path /media/* {
		root * /srv/{args[0]}/media
		header Cache-Control "public, max-age=2592000"
		header X-Content-Type-Options "nosniff"
		file_server
	}
	# Caddy sets X-Forwarded-For itself, so visitors cannot forge their IP
	handle {
		reverse_proxy 127.0.0.1:{args[1]}
	}
}

{$DOMAIN} {
	import common production {$PRODUCTION_PORT}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$STAGING_DOMAIN} {
	# Staging must stay out of search engines and away from visitors
	header X-Robots-Tag "noindex, nofollow"
	import common staging {$STAGING_PORT}
}
