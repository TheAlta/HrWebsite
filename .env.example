# Copy to .env and adjust. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=true

# Database (the compose db service reads POSTGRES_*; Django reads DATABASE_URL)
POSTGRES_DB=hrweb
POSTGRES_USER=hrweb
POSTGRES_PASSWORD=hrweb
DATABASE_URL=postgres://hrweb:hrweb@db:5432/hrweb

# Email: mailpit in development
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=noreply@localhost

# Local ports on your machine
WEB_PORT=8100
MAILPIT_PORT=8025

# Site
SITE_NAME=مشاوره منابع انسانی
WAGTAILADMIN_BASE_URL=http://localhost:8100
WAGTAIL_ADMIN_PATH=panel/
DJANGO_ADMIN_PATH=django-admin/

# Production only
# ALLOWED_HOSTS=example.ir,www.example.ir
# CSRF_TRUSTED_ORIGINS=https://example.ir,https://www.example.ir
